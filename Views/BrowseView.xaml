<UserControl x:Class="StreamPLAY.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY"
             Background="#141414">
  <UserControl.Resources>

    <DataTemplate DataType="{x:Type local:RowVM}">
      <local:RowStrip/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SpacerVM}">
      <Border Height="{Binding Height}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:GridRowVM}">
      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource PosterCard}" Margin="52,0,52,8"
                    Focusable="False">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter" BasedOn="{StaticResource ZUp}">
            <Setter Property="Margin" Value="4,6"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Cols}"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MessageVM}">
      <StackPanel Margin="56,30,56,0" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Text}" FontSize="16" Foreground="#B3B3B3" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:HeroVM}">
      <Grid Height="{Binding Height}" Margin="0,0,0,-120" ClipToBounds="True">
        <!-- Com imagem de fundo -->
        <Border local:Img.Decode="1600" local:Img.Src="{Binding Item.Backdrop}"/>
        <!-- Sem imagem de fundo: pôster desfocado + pôster nítido à direita -->
        <Grid Visibility="{Binding NoBackdrop, Converter={StaticResource BoolVis}}">
          <Border local:Img.Decode="200" local:Img.Src="{Binding Item.Logo}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Border.RenderTransform>
            <Border.Effect><BlurEffect Radius="70" RenderingBias="Performance"/></Border.Effect>
          </Border>
          <Border Background="#73141414"/>
          <Border HorizontalAlignment="Right" Margin="0,100,110,150" CornerRadius="8"
                  Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=0.667}">
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.7"/></Border.Effect>
            <Border CornerRadius="8" local:Img.Decode="520" local:Img.Src="{Binding Item.Logo}"/>
          </Border>
        </Grid>
        <!-- Degradês -->
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#F0141414" Offset="0"/>
              <GradientStop Color="#A6141414" Offset="0.32"/>
              <GradientStop Color="#00141414" Offset="0.7"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00141414" Offset="0.55"/>
              <GradientStop Color="#C0141414" Offset="0.8"/>
              <GradientStop Color="#FF141414" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <!-- Conteúdo -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="56,0,0,180" MaxWidth="640">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="S" FontFamily="{StaticResource LogoFont}" FontSize="30" Foreground="#E50914" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Item.KindLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="8,3,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding Item.Name}" FontSize="54" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                     MaxHeight="136" TextTrimming="CharacterEllipsis" LineHeight="64">
            <TextBlock.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.6"/></TextBlock.Effect>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Border Background="#E50914" CornerRadius="3" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center"
                    Visibility="{Binding Item.IsRelease, Converter={StaticResource BoolVis}}">
              <TextBlock Text="LANÇAMENTO" FontSize="12" FontWeight="Bold" Foreground="White"/>
            </Border>
            <TextBlock Text="{Binding Item.Meta}" FontSize="16" Foreground="#E5E5E5" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding Item.Plot}" FontSize="17" Foreground="White" TextWrapping="Wrap" Margin="0,12,0,0"
                     MaxHeight="76" TextTrimming="WordEllipsis" LineHeight="25">
            <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.6"/></TextBlock.Effect>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Style="{StaticResource Primary}" Tag="hero-play" AutomationProperties.Name="Assistir">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="22" Height="22" Margin="0,0,10,0"><Path Style="{StaticResource IcoF}" Data="{StaticResource G.Play}"/></Viewbox>
                <TextBlock Text="{Binding PlayText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Secondary}" Tag="hero-info" Margin="12,0,0,0" AutomationProperties.Name="Mais informações">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="22" Height="22" Margin="0,0,10,0"><Path Style="{StaticResource IcoS}" Data="{StaticResource G.Info}"/></Viewbox>
                <TextBlock Text="Mais informações" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ListBox x:Name="Feed" Style="{StaticResource Bare}" Padding="0,0,0,60"/>

    <!-- Subtítulo da página (Filmes / Séries + Categorias) -->
    <Grid x:Name="SubBar" VerticalAlignment="Top" Margin="0,68,0,0" Height="60">
      <Border x:Name="SubBg" Background="#141414" Opacity="0" IsHitTestVisible="False"/>
      <StackPanel Orientation="Horizontal" Margin="56,0,0,0" VerticalAlignment="Center">
        <Button x:Name="BackBtn" Style="{StaticResource Plain}" Tag="back" Width="40" Height="40" Padding="8" Margin="-10,0,8,0"
                Visibility="Collapsed" AutomationProperties.Name="Voltar">
          <Viewbox><Path Style="{StaticResource IcoS}" Data="{StaticResource G.Back}" StrokeThickness="2.4"/></Viewbox>
        </Button>
        <TextBlock x:Name="PageTitle" FontSize="34" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
          <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.6"/></TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="PageCount" FontSize="16" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="14,6,0,0"/>
        <Button x:Name="CatBtn" Style="{StaticResource Plain}" Margin="28,4,0,0" Background="#E6000000" BorderBrush="White"
                BorderThickness="1" Padding="12,5,10,5" Click="CatBtn_Click" AutomationProperties.Name="Categorias">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Categorias" FontSize="14" FontWeight="SemiBold"/>
            <Viewbox Width="10" Height="10" Margin="22,1,0,0">
              <Path Data="M2,6 L12,18 L22,6 Z" Width="24" Height="24" Fill="White"/>
            </Viewbox>
          </StackPanel>
        </Button>
      </StackPanel>
      <Popup x:Name="CatPopup" PlacementTarget="{Binding ElementName=CatBtn}" Placement="Bottom" StaysOpen="False"
             AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="2">
        <Border Background="#F2000000" BorderBrush="#4D4D4D" BorderThickness="1" Padding="10,10" MaxHeight="480">
          <ScrollViewer VerticalScrollBarVisibility="Auto" local:Smooth.On="True">
            <ItemsControl x:Name="CatList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid x:Name="CatGrid" Columns="1"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Plain}" Tag="cat" HorizontalContentAlignment="Left" Padding="10,6" MinWidth="170">
                    <TextBlock FontSize="14" Foreground="White">
                      <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Items.Count, StringFormat='  ({0})', Mode=OneWay}" Foreground="#8C8C8C"/>
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
