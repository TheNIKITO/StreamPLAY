<UserControl x:Class="StreamPLAY.RowStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="56,0,0,0">
      <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" Foreground="#E5E5E5" VerticalAlignment="Bottom"/>
      <Button x:Name="AllBtn" Tag="all" Style="{StaticResource LinkBtn}" Margin="14,0,0,2" VerticalAlignment="Bottom" Opacity="0"
              Foreground="#54B9C5" FontSize="14" FontWeight="SemiBold">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="AllText" Text="Ver tudo"/>
          <Viewbox Width="11" Height="11" Margin="5,1,0,0">
            <Path Data="{StaticResource G.ChevR}" Width="24" Height="24" Stroke="#54B9C5" StrokeThickness="3.2"/>
          </Viewbox>
        </StackPanel>
      </Button>
    </StackPanel>

    <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True">
      <Canvas x:Name="Lane" Height="200">
        <ItemsControl x:Name="Strip" Canvas.Left="56" Canvas.Top="14" Focusable="False" ItemContainerStyle="{StaticResource ZUp}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.RenderTransform><TranslateTransform x:Name="Shift"/></ItemsControl.RenderTransform>
        </ItemsControl>
      </Canvas>

      <Button x:Name="LeftBtn" Style="{StaticResource Plain}" HorizontalAlignment="Left" Width="52" Margin="0,14,0,22"
              Background="#80000000" Opacity="0" Visibility="Collapsed" Click="Left_Click" AutomationProperties.Name="Anterior">
        <Viewbox Width="22"><Path Data="{StaticResource G.ChevL}" Width="24" Height="24" Stroke="White" StrokeThickness="2.6"/></Viewbox>
      </Button>
      <Button x:Name="RightBtn" Style="{StaticResource Plain}" HorizontalAlignment="Right" Width="52" Margin="0,14,0,22"
              Background="#80000000" Opacity="0" Visibility="Collapsed" Click="Right_Click" AutomationProperties.Name="Próximo">
        <Viewbox Width="22"><Path Data="{StaticResource G.ChevR}" Width="24" Height="24" Stroke="White" StrokeThickness="2.6"/></Viewbox>
      </Button>
    </Grid>
  </Grid>
</UserControl>
