<UserControl x:Class="StreamPLAY.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY"
             Background="#0D0D11">
  <UserControl.Resources>
    <!-- grupos (Todos, Favoritos, Esportes...) em cima: o escolhido fica vermelho -->
    <Style x:Key="CatChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#D8D8E0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="GroupName" Value="cats"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#1A1A20" CornerRadius="18" Padding="15,7" BorderBrush="#2E2E38" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#8A8A94"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E50914"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#E50914"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- linha de canal da lista da esquerda: número, logo, nome e o que está passando -->
    <Style x:Key="ChItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <!-- sem foco o ListBox não seleciona no clique: a seleção (e o duplo clique para assistir) é feita em Ch_Click -->
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Ch_Click"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="0,8" Margin="8,1" CornerRadius="8">
              <Grid>
                <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,4" CornerRadius="1.5" Background="#E50914" Visibility="Hidden"/>
                <Grid Margin="12,0,12,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Numero}" Foreground="#6E6E78" FontSize="13" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Height="38" CornerRadius="6" Background="#1A1A20">
                    <Grid>
                      <TextBlock Text="{Binding Card.Initials}" FontSize="14" FontWeight="Bold" Foreground="#4A4A54" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding (local:Img.Has), ElementName=logo}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Image x:Name="logo" local:Img.Decode="120" local:Img.Src="{Binding Card.Logo}" Stretch="Uniform" Margin="5,4"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="name" Text="{Binding Card.Name}" Foreground="#D8D8E0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Card.Agora}" Foreground="#8A8A94" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Card.TemGuia, Converter={StaticResource BoolVis}}"/>
                    <Grid Height="2" Margin="0,5,0,0" Visibility="{Binding Card.TemGuia, Converter={StaticResource BoolVis}}">
                      <Border Background="#2A2A32"/>
                      <Border Background="#E50914" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Card.AgoraProgresso}"/></Border.RenderTransform>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <Viewbox Grid.Column="3" Width="15" Height="15" VerticalAlignment="Center"
                           Visibility="{Binding Card.IsFav, Converter={StaticResource BoolVis}}">
                    <Path Data="{StaticResource G.Star}" Width="24" Height="24" Fill="#FFC107"/>
                  </Viewbox>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#17171D"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="b" Property="Background" Value="#1E1E26"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,68,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <!-- título + grupos -->
    <StackPanel Margin="40,20,40,6">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Border Width="4" Height="24" CornerRadius="2" Background="#E50914" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="CatTitle" Text="Canais" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="CatCount" FontSize="14" Foreground="#8A8A94" Margin="14,4,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <ItemsControl x:Name="Cats" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource CatChip}" IsChecked="{Binding Selected, Mode=OneTime}" Checked="Cat_Checked" AutomationProperties.Name="{Binding Name}">
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Count, StringFormat='  {0}', Mode=OneWay}" Foreground="#B3FFFFFF"/>
              </TextBlock>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid Grid.Row="1" Margin="32,6,40,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- todos os canais do grupo, com rolagem -->
      <Border Background="#121217" CornerRadius="12" BorderBrush="#1F1F27" BorderThickness="1">
        <Grid>
          <ListBox x:Name="ChList" Style="{StaticResource Bare}" ItemContainerStyle="{StaticResource ChItem}" Padding="0,6"
                   SelectionChanged="ChList_SelectionChanged" VirtualizingPanel.ScrollUnit="Pixel"/>
          <StackPanel x:Name="Vazio" Margin="24,30,24,0" Visibility="Collapsed">
            <TextBlock x:Name="VazioTitulo" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="VazioTexto" FontSize="14" Foreground="#9A9AA4" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- painel do canal escolhido -->
      <ScrollViewer x:Name="Painel" Grid.Column="1" Margin="32,0,0,0" VerticalScrollBarVisibility="Auto" local:Smooth.On="True" Focusable="False">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <Border Width="300" Height="170" CornerRadius="12" Background="#16161C" BorderBrush="#26262E" BorderThickness="1" HorizontalAlignment="Left">
            <Grid>
              <TextBlock x:Name="PIniciais" FontSize="44" FontWeight="Bold" Foreground="#3A3A44" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding (local:Img.Has), ElementName=PLogo}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Image x:Name="PLogo" local:Img.Decode="420" Stretch="Uniform" Margin="28,22"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Border Background="#E50914" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="AO VIVO" FontSize="11.5" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PCat" FontSize="14" Foreground="#9A9AA4" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="PNome" FontSize="34" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>

          <!-- guia: agora e a seguir -->
          <StackPanel x:Name="PGuia" Margin="0,18,0,0">
            <TextBlock Text="AGORA" FontSize="12" FontWeight="Bold" Foreground="#8A8A94"/>
            <TextBlock x:Name="PAgora" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <DockPanel Margin="0,8,0,0" MaxWidth="460" HorizontalAlignment="Left">
              <TextBlock x:Name="PHorario" DockPanel.Dock="Right" FontSize="13" Foreground="#9A9AA4" Margin="12,0,0,0" VerticalAlignment="Center"/>
              <Grid Height="4" VerticalAlignment="Center" Width="320">
                <Border Background="#2A2A32" CornerRadius="2"/>
                <Border Background="#E50914" CornerRadius="2" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><ScaleTransform x:Name="PProg" ScaleX="0"/></Border.RenderTransform>
                </Border>
              </Grid>
            </DockPanel>
            <TextBlock x:Name="PDesc" FontSize="14.5" Foreground="#C8C8D0" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"
                       MaxHeight="64" TextTrimming="WordEllipsis"/>
            <TextBlock Text="A SEGUIR" FontSize="12" FontWeight="Bold" Foreground="#8A8A94" Margin="0,18,0,6"/>
            <ItemsControl x:Name="PProximos" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <TextBlock Text="{Binding Inicio, StringFormat=HH:mm}" Width="54" FontSize="14" Foreground="#9A9AA4"/>
                    <TextBlock Text="{Binding Titulo}" FontSize="14.5" Foreground="#E4E4EA" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock x:Name="PSemGuia" Text="Sem programação disponível para este canal." FontSize="14" Foreground="#8A8A94" Margin="0,18,0,0"/>

          <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
            <Button Style="{StaticResource Primary}" Click="Assistir_Click" AutomationProperties.Name="Assistir">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="20" Height="20" Margin="0,0,10,0"><Path Style="{StaticResource IcoF}" Data="{StaticResource G.Play}"/></Viewbox>
                <TextBlock Text="Assistir" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="FavBtn" Style="{StaticResource Secondary}" Margin="12,0,0,0" Click="Fav_Click" AutomationProperties.Name="Favoritar">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                  <Path x:Name="FavIcon" Data="{StaticResource G.Star}" Width="24" Height="24" Stroke="White" StrokeThickness="1.8" Fill="Transparent"/>
                </Viewbox>
                <TextBlock x:Name="FavText" Text="Favoritar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="Dica: clique duas vezes num canal da lista para assistir direto." FontSize="12.5" Foreground="#6E6E78" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
