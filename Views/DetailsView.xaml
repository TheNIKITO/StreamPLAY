<UserControl x:Class="StreamPLAY.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY">
  <Grid>
    <Border x:Name="Dim" Background="#B3000000" MouseLeftButtonDown="Dim_MouseDown"/>
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" local:Smooth.On="True" Focusable="False">
      <Grid>
        <Border Background="Transparent" MouseLeftButtonDown="Dim_MouseDown"/>
        <Border x:Name="CardBox" Width="900" Margin="0,34,0,60" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#181818" CornerRadius="8">
          <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.8"/></Border.Effect>
          <StackPanel>
            <!-- Topo com imagem -->
            <Grid Height="480" ClipToBounds="True">
              <Border x:Name="Backdrop" CornerRadius="8,8,0,0" local:Img.Decode="1200"/>
              <Grid x:Name="PosterArt" Visibility="Collapsed">
                <Border x:Name="Blur" CornerRadius="8,8,0,0" local:Img.Decode="200" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                  <Border.RenderTransform><ScaleTransform ScaleX="1.3" ScaleY="1.3"/></Border.RenderTransform>
                  <Border.Effect><BlurEffect Radius="60" RenderingBias="Performance"/></Border.Effect>
                </Border>
                <Border x:Name="Poster" HorizontalAlignment="Right" Margin="0,40,48,70" Width="250" CornerRadius="6" local:Img.Decode="420">
                  <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7"/></Border.Effect>
                </Border>
              </Grid>
              <Border CornerRadius="8,8,0,0" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00181818" Offset="0.35"/>
                    <GradientStop Color="#D9181818" Offset="0.82"/>
                    <GradientStop Color="#FF181818" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B3181818" Offset="0"/>
                    <GradientStop Color="#00181818" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <Button Style="{StaticResource Round}" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="16" Click="Close_Click" Background="#181818" AutomationProperties.Name="Fechar">
                <Path Style="{StaticResource IcoS}" Data="{StaticResource G.Close}" StrokeThickness="2.6"/>
              </Button>

              <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,36" HorizontalAlignment="Left" MaxWidth="560">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <TextBlock Text="S" FontFamily="{StaticResource LogoFont}" FontSize="26" Foreground="#E50914" VerticalAlignment="Center"/>
                  <TextBlock x:Name="KindText" FontSize="13" FontWeight="SemiBold" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="8,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" LineHeight="52">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.6"/></TextBlock.Effect>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Click="Play_Click" AutomationProperties.Name="Assistir">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="22" Height="22" Margin="0,0,10,0"><Path Style="{StaticResource IcoF}" Data="{StaticResource G.Play}"/></Viewbox>
                      <TextBlock x:Name="PlayText" Text="Assistir" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="RestartBtn" Style="{StaticResource Secondary}" Margin="10,0,0,0" Click="Restart_Click" Visibility="Collapsed"
                          ToolTip="Assistir do início" AutomationProperties.Name="Do início">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="20" Height="20" Margin="0,0,8,0"><Path Style="{StaticResource IcoS}" Data="{StaticResource G.Restart}" StrokeThickness="2.4"/></Viewbox>
                      <TextBlock Text="Do início" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="FavBtn" Style="{StaticResource Round}" Margin="12,0,0,0" Click="Fav_Click" AutomationProperties.Name="Minha lista">
                    <Path x:Name="FavIcon" Style="{StaticResource IcoS}" Data="{StaticResource G.Plus}" StrokeThickness="2.6"/>
                  </Button>
                </StackPanel>
                <Grid x:Name="ProgressRow" Margin="0,16,0,0" Visibility="Collapsed" HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Height="3" Background="#666666" VerticalAlignment="Center"/>
                  <Border x:Name="ProgressFill" Height="3" Background="#E50914" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ProgressText" Grid.Column="1" Foreground="#B3B3B3" FontSize="13" Margin="12,0,0,0"/>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Informações -->
            <Grid Margin="48,6,48,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <WrapPanel x:Name="MetaPanel" Margin="0,0,0,12"/>
                <TextBlock x:Name="PlotText" FontSize="16" Foreground="White" TextWrapping="Wrap" LineHeight="25"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="GenreText" FontSize="14" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock x:Name="CatText" FontSize="14" Foreground="#777777" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <!-- Episódios -->
            <StackPanel x:Name="EpisodesBox" Margin="48,0,48,40" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,14">
                <TextBlock Text="Episódios" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SeasonLabel" FontSize="16" Foreground="#B3B3B3" Margin="14,4,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <WrapPanel x:Name="Seasons" Margin="0,0,0,10"/>
              <StackPanel x:Name="EpisodeList"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
