<UserControl x:Class="StreamPLAY.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY">
  <Grid>
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#3A0A0D" Offset="0"/>
        <GradientStop Color="#140A0A" Offset="0.45"/>
        <GradientStop Color="#000000" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>

    <TextBlock Text="STREAMPLAY" FontFamily="{StaticResource LogoFont}" FontSize="44" Foreground="#E50914"
               Margin="56,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    <Button x:Name="BackBtn" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,56,0"
            Click="Back_Click" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Voltar para a lista atual">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Style="{StaticResource IcoS}" Data="{StaticResource G.Back}" StrokeThickness="2.6"/></Viewbox>
        <TextBlock Text="Voltar para a lista atual" FontWeight="SemiBold"/>
      </StackPanel>
    </Button>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,80,0,0" local:Smooth.On="True">
      <Border Width="560" Margin="0,10,0,40" Padding="52,44" Background="#C7000000" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Adicione sua lista" FontSize="32" FontWeight="Bold"/>
          <TextBlock Text="O StreamPLAY organiza seus canais, filmes e séries sozinho, lendo o group-title da sua lista M3U."
                     FontSize="15" Foreground="#B3B3B3" TextWrapping="Wrap" Margin="0,10,0,26" LineHeight="22"/>

          <Button Style="{StaticResource RedBtn}" Click="Pick_Click" HorizontalAlignment="Stretch" Padding="0,13" AutomationProperties.Name="Escolher arquivo .m3u">
            <TextBlock Text="Escolher arquivo .m3u" FontSize="16" FontWeight="SemiBold"/>
          </Button>
          <Button Style="{StaticResource GhostBtn}" Click="New_Click" HorizontalAlignment="Stretch" Padding="0,12" Margin="0,10,0,0"
                  AutomationProperties.Name="Criar uma lista nova">
            <TextBlock Text="Criar uma lista nova" FontSize="15" FontWeight="SemiBold"/>
          </Button>

          <Grid Margin="0,26,0,16">
            <Border Height="1" Background="#333333" VerticalAlignment="Center"/>
            <Border Background="#0C0C0C" HorizontalAlignment="Center" Padding="12,0">
              <TextBlock Text="ou cole o link da lista" Foreground="#8C8C8C" FontSize="13"/>
            </Border>
          </Grid>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Carregar" Margin="8,0,0,0" Padding="18,0"
                    FontWeight="SemiBold" Click="Url_Click"/>
            <TextBox x:Name="UrlBox" Style="{StaticResource Field}" Tag="http://exemplo.com/lista.m3u" KeyDown="UrlBox_KeyDown"
                     AutomationProperties.Name="Link da lista"/>
          </DockPanel>

          <TextBlock x:Name="ErrorText" Foreground="#E87C03" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="LoadingText" Text="Carregando..." Foreground="#B3B3B3" FontSize="14" Margin="0,14,0,0" Visibility="Collapsed"/>

          <TextBlock Text="Como organizar sua lista" FontSize="17" FontWeight="SemiBold" Margin="0,34,0,10"/>
          <Border Background="#0D0D11" CornerRadius="4" Padding="16,14" BorderBrush="#2A2A2A" BorderThickness="1">
            <TextBlock x:Name="Guide" FontFamily="Consolas" FontSize="12.5" Foreground="#C8C8C8" TextWrapping="Wrap" LineHeight="19"/>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
