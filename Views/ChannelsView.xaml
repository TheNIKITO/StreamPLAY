<UserControl x:Class="StreamPLAY.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY"
             Background="#0D0D11">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type local:GridRowVM}">
      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ChannelCard}" Margin="26,0,30,0" Focusable="False">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter" BasedOn="{StaticResource ZUp}">
            <Setter Property="Margin" Value="6"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Cols}"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MessageVM}">
      <StackPanel Margin="32,20,40,0" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Text}" FontSize="15" Foreground="#B3B3B3" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23"/>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="CatItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <!-- sem foco o ListBox não seleciona no clique: a seleção é feita em Cat_Click -->
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Cat_Click"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="0,11">
              <Grid>
                <Border x:Name="bar" Width="4" HorizontalAlignment="Left" Background="#E50914" Visibility="Hidden"/>
                <DockPanel Margin="28,0,18,0">
                  <TextBlock x:Name="count" DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#6E6E6E" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock x:Name="name" Text="{Binding Name}" Foreground="#B3B3B3" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C1C1C"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="b" Property="Background" Value="#202020"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
                <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="count" Property="Foreground" Value="#B3B3B3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,68,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <Border Background="#0E0E0E" BorderBrush="#222222" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,16,0,0">
        <TextBlock DockPanel.Dock="Top" Text="Canais" FontSize="30" FontWeight="Bold" Margin="28,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" x:Name="Total" FontSize="13" Foreground="#8C8C8C" Margin="28,0,0,14"/>
        <ListBox x:Name="Cats" Style="{StaticResource Bare}" ItemContainerStyle="{StaticResource CatItem}"
                 SelectionChanged="Cats_SelectionChanged" Padding="0,0,0,20"
                 VirtualizingPanel.ScrollUnit="Item"/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="32,22,0,10">
        <TextBlock x:Name="CatTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="CatCount" FontSize="15" Foreground="#8C8C8C" Margin="12,0,0,3" VerticalAlignment="Bottom"/>
      </StackPanel>
      <ListBox x:Name="ChGrid" Grid.Row="1" Style="{StaticResource Bare}" Padding="0,0,0,40"/>
    </Grid>
  </Grid>
</UserControl>
