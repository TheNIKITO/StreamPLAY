<UserControl x:Class="StreamPLAY.RowStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Título com o traço vermelho; "Ver tudo" à direita -->
    <DockPanel Margin="56,0,56,0">
      <Button x:Name="AllBtn" DockPanel.Dock="Right" Tag="all" Style="{StaticResource LinkBtn}" VerticalAlignment="Center"
              Foreground="#D0D0D8" FontSize="14.5" FontWeight="SemiBold">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="AllText" Text="Ver tudo"/>
          <Viewbox Width="11" Height="11" Margin="7,1,0,0">
            <Path Data="{StaticResource G.ChevR}" Width="24" Height="24" Stroke="#D0D0D8" StrokeThickness="3.2"/>
          </Viewbox>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal">
        <Border Width="4" Height="24" CornerRadius="2" Background="#E50914" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True">
      <Canvas x:Name="Lane" Height="200">
        <ItemsControl x:Name="Strip" Canvas.Left="56" Canvas.Top="14" Focusable="False" ItemContainerStyle="{StaticResource ZUp}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.RenderTransform><TranslateTransform x:Name="Shift"/></ItemsControl.RenderTransform>
        </ItemsControl>
      </Canvas>

      <Button x:Name="LeftBtn" Style="{StaticResource Plain}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="44" Height="44"
              Margin="12,0,0,0" local:UI.Radius="22" Background="#CC0D0D11" BorderBrush="#40FFFFFF" BorderThickness="1"
              Opacity="0" Visibility="Collapsed" Click="Left_Click" AutomationProperties.Name="Anterior">
        <Viewbox Width="18"><Path Data="{StaticResource G.ChevL}" Width="24" Height="24" Stroke="White" StrokeThickness="2.6"/></Viewbox>
      </Button>
      <Button x:Name="RightBtn" Style="{StaticResource Plain}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="44" Height="44"
              Margin="0,0,12,0" local:UI.Radius="22" Background="#CC0D0D11" BorderBrush="#40FFFFFF" BorderThickness="1"
              Opacity="0" Visibility="Collapsed" Click="Right_Click" AutomationProperties.Name="Próximo">
        <Viewbox Width="18"><Path Data="{StaticResource G.ChevR}" Width="24" Height="24" Stroke="White" StrokeThickness="2.6"/></Viewbox>
      </Button>
    </Grid>
  </Grid>
</UserControl>
