<UserControl x:Class="StreamPLAY.NovidadesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY">
  <Grid>
    <Border Background="#B3000000" MouseLeftButtonDown="Dim_MouseDown"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" local:Smooth.On="True">
      <Grid>
        <Border Background="Transparent" MouseLeftButtonDown="Dim_MouseDown"/>
        <Border Width="560" Margin="0,70,0,50" Padding="36,30,36,32" Background="#141419" CornerRadius="12" BorderBrush="#26FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Round}" Width="36" Height="36" Click="Close_Click" AutomationProperties.Name="Fechar">
                <Path Style="{StaticResource IcoS}" Data="{StaticResource G.Close}" StrokeThickness="2.6"/>
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NOVIDADES" Foreground="#FF2A35" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="O que chegou de novo" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <StackPanel x:Name="Lista" Margin="0,18,0,0"/>
            <Button x:Name="OkBtn" Style="{StaticResource RedBtn}" Click="Close_Click" HorizontalAlignment="Stretch" Padding="0,13" Margin="0,22,0,0"
                    AutomationProperties.Name="Entendi">
              <TextBlock Text="Entendi" FontSize="15" FontWeight="SemiBold"/>
            </Button>
            <Button Style="{StaticResource LinkBtn}" Click="Site_Click" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="14"
                    Content="Ver todas as novidades no site"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
