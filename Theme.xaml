<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StreamPLAY">

  <!-- Cores (paleta estilo Netflix) -->
  <SolidColorBrush x:Key="Bg" Color="#141414"/>
  <SolidColorBrush x:Key="Panel" Color="#181818"/>
  <SolidColorBrush x:Key="Card" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Hover" Color="#333333"/>
  <SolidColorBrush x:Key="Sub" Color="#B3B3B3"/>
  <SolidColorBrush x:Key="Dim" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Red" Color="#E50914"/>
  <SolidColorBrush x:Key="Line" Color="#3A3A3A"/>
  <FontFamily x:Key="LogoFont">Bahnschrift SemiBold Condensed, Impact</FontFamily>
  <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <local:Ratio x:Key="Ratio"/>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>

  <!-- Ícones (grade 24x24) -->
  <Geometry x:Key="G.Play">M7,3.5 L20.5,12 L7,20.5 Z</Geometry>
  <Geometry x:Key="G.Pause">M5.5,3.5 H10 V20.5 H5.5 Z M14,3.5 H18.5 V20.5 H14 Z</Geometry>
  <Geometry x:Key="G.Back">M20,12 H4.5 M11,5 L4,12 L11,19</Geometry>
  <Geometry x:Key="G.Arc">M12,5 A8,8 0 1 1 6.34,7.34</Geometry>
  <Geometry x:Key="G.ArcHead">M13.5,1.6 L9.2,5 L13.5,8.4 Z</Geometry>
  <Geometry x:Key="G.Vol">M2.5,9 H7 L12.5,4.3 V19.7 L7,15 H2.5 Z</Geometry>
  <Geometry x:Key="G.VolWaves">M15.6,8.6 A4.8,4.8 0 0 1 15.6,15.4 M18.4,5.6 A9,9 0 0 1 18.4,18.4</Geometry>
  <Geometry x:Key="G.MuteX">M15.5,9.5 L21,15 M21,9.5 L15.5,15</Geometry>
  <Geometry x:Key="G.Next">M3.5,4 L15,12 L3.5,20 Z M17,4 H20.5 V20 H17 Z</Geometry>
  <Geometry x:Key="G.Episodes">M2.5,9.5 H15.5 V20.5 H2.5 Z M6,6 H19 V16.5 M9.5,2.5 H22 V13</Geometry>
  <Geometry x:Key="G.Subs">M2.5,4 H21.5 V16.5 H11.5 L6.5,20.5 V16.5 H2.5 Z M6.5,9 H10.5 M13,9 H17.5 M6.5,12.5 H15</Geometry>
  <Geometry x:Key="G.Speed">M4.3,18.5 A9,9 0 1 1 19.7,18.5 M12,14 L16.5,8.8</Geometry>
  <Geometry x:Key="G.Full">M3,9 V3 H9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15</Geometry>
  <Geometry x:Key="G.ExitFull">M9,3 V9 H3 M15,3 V9 H21 M21,15 H15 V21 M3,15 H9 V21</Geometry>
  <Geometry x:Key="G.Close">M5,5 L19,19 M19,5 L5,19</Geometry>
  <Geometry x:Key="G.Plus">M12,4 V20 M4,12 H20</Geometry>
  <Geometry x:Key="G.Check">M4,12.5 L9.5,18 L20,6.5</Geometry>
  <Geometry x:Key="G.Info">M12,2.5 A9.5,9.5 0 1 1 11.99,2.5 Z M12,11 V17 M12,7.2 V7.6</Geometry>
  <Geometry x:Key="G.Search">M10.5,3 A7.5,7.5 0 1 1 10.49,3 Z M16,16 L21.5,21.5</Geometry>
  <Geometry x:Key="G.ChevL">M15,4 L7,12 L15,20</Geometry>
  <Geometry x:Key="G.ChevR">M9,4 L17,12 L9,20</Geometry>
  <Geometry x:Key="G.ChevD">M5,9 L12,16 L19,9</Geometry>
  <Geometry x:Key="G.ChevU">M5,15 L12,8 L19,15</Geometry>
  <Geometry x:Key="G.List">M8.5,6 H21 M8.5,12 H21 M8.5,18 H21 M3.5,6 H4.5 M3.5,12 H4.5 M3.5,18 H4.5</Geometry>
  <Geometry x:Key="G.Star">M12,2.5 L14.9,8.6 L21.5,9.3 L16.6,13.8 L18,20.4 L12,17 L6,20.4 L7.4,13.8 L2.5,9.3 L9.1,8.6 Z</Geometry>
  <Geometry x:Key="G.Gear">M12,8.5 A3.5,3.5 0 1 1 11.99,8.5 Z M12,2.5 V5 M12,19 V21.5 M2.5,12 H5 M19,12 H21.5 M5.3,5.3 L7.1,7.1 M16.9,16.9 L18.7,18.7 M5.3,18.7 L7.1,16.9 M16.9,7.1 L18.7,5.3</Geometry>
  <Geometry x:Key="G.Restart">M4,12 A8,8 0 1 0 6.3,6.3 M4,3.5 V8 H8.5</Geometry>

  <Style x:Key="IcoF" TargetType="Path">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
  </Style>
  <Style x:Key="IcoS" TargetType="Path">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>

  <!-- Botão base -->
  <Style x:Key="Plain" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding local:UI.Radius}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Opacity" Value="0.78"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="24,9,28,9"/>
    <Setter Property="local:UI.Radius" Value="4"/>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="#B36D6D6E"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="22,9,26,9"/>
    <Setter Property="local:UI.Radius" Value="4"/>
  </Style>
  <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="#E50914"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="22,10"/>
    <Setter Property="local:UI.Radius" Value="4"/>
  </Style>
  <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="#26FFFFFF"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="local:UI.Radius" Value="4"/>
  </Style>
  <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Foreground" Value="#B3B3B3"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- Linha clicável (episódios, listas do player) -->
  <Style x:Key="RowBtn" TargetType="Button">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botão redondo com borda (+ minha lista, fechar) -->
  <Style x:Key="Round" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="99" Background="#99242424" BorderBrush="#B3FFFFFF" BorderThickness="2">
            <Viewbox Margin="11"><ContentPresenter/></Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="White"/>
              <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botão de ícone do player (cresce no hover) -->
  <Style x:Key="PBtn" TargetType="Button">
    <Setter Property="Width" Value="52"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
            <Viewbox Margin="10"><ContentPresenter/></Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ícone pequeno da barra superior -->
  <Style x:Key="TopIcon" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="9"/>
  </Style>

  <!-- Botões da janela (minimizar / maximizar / fechar) -->
  <Style x:Key="Cap" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="#D0D0D0"/>
    <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CapClose" TargetType="Button" BasedOn="{StaticResource Cap}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#E81123"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Abas do menu superior -->
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#E5E5E5"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Margin" Value="0,0,22,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="GroupName" Value="nav"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="Transparent" Padding="0,8">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#B3B3B3"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Chips (temporadas, buffer) -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="#2E2E2E" CornerRadius="16" Padding="16,7" BorderBrush="#4D4D4D" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="#B3B3B3"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="White"/>
              <Setter TargetName="b" Property="BorderBrush" Value="White"/>
              <Setter Property="Foreground" Value="Black"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Interruptor -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel Background="Transparent" LastChildFill="True">
            <Border x:Name="track" DockPanel.Dock="Right" Width="44" Height="24" CornerRadius="12" Background="#4D4D4D">
              <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="#E50914"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Caixa de texto escura -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="#CC000000"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CaretBrush" Value="White"/>
    <Setter Property="SelectionBrush" Value="#E50914"/>
    <Setter Property="BorderBrush" Value="#808080"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <Grid>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#8C8C8C" Margin="{TemplateBinding Padding}"
                         VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Padding="2,0"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de rolagem fina -->
  <Style x:Key="ThumbBar" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" Background="#55FFFFFF" CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="#99FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="Transparent" Margin="0,2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb Style="{StaticResource ThumbBar}" Margin="1,0"/></Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="Transparent" Margin="2,0">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb><Thumb Style="{StaticResource ThumbBar}" Margin="0,1"/></Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Listas sem destaque de seleção -->
  <Style x:Key="BareItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Bare" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource BareItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="local:Smooth.On" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Card (pôster) que cresce no hover -->
  <Style x:Key="CardBtn" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.08" BeginTime="0:0:0.06" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.08" BeginTime="0:0:0.06" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ZUp" TargetType="ContentPresenter">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Panel.ZIndex" Value="5"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Pôster de filme / série -->
  <DataTemplate x:Key="PosterCard">
    <Button x:Name="btn" Style="{StaticResource CardBtn}" Tag="open" AutomationProperties.Name="{Binding Name}"
            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=1.5}">
      <Grid>
        <Border x:Name="art" CornerRadius="4" Background="#262626">
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                     Margin="12" FontSize="16" FontWeight="SemiBold" Foreground="#9A9A9A"/>
        </Border>
        <Border CornerRadius="4" local:Img.Decode="240" local:Img.Src="{Binding Logo}"/>
        <Border x:Name="info" CornerRadius="0,0,4,4" VerticalAlignment="Bottom" Opacity="0" Padding="10,28,10,10">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0"/>
              <GradientStop Color="#E6000000" Offset="0.6"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel>
            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" Foreground="#B3B3B3" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <Border Background="#E50914" CornerRadius="2" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}">
          <TextBlock Text="NOVO" Foreground="White" FontSize="10" FontWeight="Bold"/>
        </Border>
        <Grid VerticalAlignment="Bottom" Height="4" Margin="8,0,8,8" Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}">
          <Border Background="#80808080"/>
          <Border Background="#E50914" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform>
          </Border>
        </Grid>
      </Grid>
    </Button>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, ElementName=btn}" Value="True">
        <Setter TargetName="info" Property="Opacity" Value="1"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Card de canal -->
  <DataTemplate x:Key="ChannelCard">
    <Button x:Name="btn" Style="{StaticResource CardBtn}" Tag="play" AutomationProperties.Name="{Binding Name}"
            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=0.68}">
      <Border x:Name="card" CornerRadius="6" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="36"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Initials}" FontSize="30" FontWeight="Bold" Foreground="#4A4A4A"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image local:Img.Decode="220" local:Img.Src="{Binding Logo}" Stretch="Uniform" Margin="22,16,22,4"/>
          <Border Grid.Row="1" Background="#141414" CornerRadius="0,0,6,6">
            <TextBlock Text="{Binding Name}" Foreground="#E5E5E5" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
          </Border>
          <Button x:Name="fav" Tag="fav" Style="{StaticResource Plain}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Width="30" Height="30" Padding="6" Margin="2" Opacity="0" ToolTip="Favoritar">
            <Viewbox>
              <Path x:Name="star" Data="{StaticResource G.Star}" Width="24" Height="24" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>
    </Button>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, ElementName=btn}" Value="True">
        <Setter TargetName="card" Property="BorderBrush" Value="White"/>
        <Setter TargetName="fav" Property="Opacity" Value="1"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFav}" Value="True">
        <Setter TargetName="fav" Property="Opacity" Value="1"/>
        <Setter TargetName="star" Property="Fill" Value="#FFC107"/>
        <Setter TargetName="star" Property="Stroke" Value="#FFC107"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
