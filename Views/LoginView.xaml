<UserControl x:Class="StreamPLAY.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamPLAY">
  <UserControl.Resources>
    <Style x:Key="SenhaField" TargetType="PasswordBox">
      <Setter Property="Background" Value="#CC000000"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#E50914"/>
      <Setter Property="BorderBrush" Value="#808080"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#3A0A0D" Offset="0"/>
        <GradientStop Color="#140A0A" Offset="0.45"/>
        <GradientStop Color="#000000" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>

    <TextBlock Text="STREAMPLAY" FontFamily="{StaticResource LogoFont}" FontSize="44" Foreground="#E50914"
               Margin="56,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,80,0,0" local:Smooth.On="True">
      <Border Width="460" Margin="0,10,0,40" Padding="52,44" Background="#C7000000" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <!-- Entrar -->
          <StackPanel x:Name="LoginPanel">
            <TextBlock Text="Entrar" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Use o login e a senha que você recebeu." FontSize="15" Foreground="#B3B3B3" TextWrapping="Wrap" Margin="0,10,0,26"/>

            <TextBox x:Name="LoginBox" Style="{StaticResource Field}" Tag="Login" KeyDown="Field_KeyDown"
                     AutomationProperties.Name="Login"/>
            <Grid Margin="0,12,0,0">
              <PasswordBox x:Name="SenhaBox" Style="{StaticResource SenhaField}" KeyDown="Field_KeyDown" PasswordChanged="Senha_Changed"
                           AutomationProperties.Name="Senha"/>
              <TextBlock x:Name="SenhaHint" Text="Senha" Foreground="#8C8C8C" FontSize="15" Margin="14,0,0,0"
                         VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#E87C03" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

            <Button x:Name="EntrarBtn" Style="{StaticResource RedBtn}" Click="Entrar_Click" HorizontalAlignment="Stretch" Padding="0,13" Margin="0,24,0,0"
                    AutomationProperties.Name="Entrar">
              <TextBlock x:Name="EntrarText" Text="Entrar" FontSize="16" FontWeight="SemiBold"/>
            </Button>
          </StackPanel>

          <!-- Bloqueado -->
          <StackPanel x:Name="BloqPanel" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" Background="#33E50914" HorizontalAlignment="Left" Margin="0,0,0,18">
              <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="#E50914"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="BloqTitulo" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="BloqMsg" FontSize="15" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>

            <Border x:Name="PixBox" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,20,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Copiar" Padding="14,6" Margin="12,0,0,0"
                        VerticalAlignment="Center" Click="CopiarPix_Click" AutomationProperties.Name="Copiar chave Pix"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="CHAVE PIX" Foreground="#8C8C8C" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="PixText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock x:Name="BloqStatus" Foreground="#E87C03" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

            <Button x:Name="DeNovoBtn" Style="{StaticResource RedBtn}" Click="DeNovo_Click" HorizontalAlignment="Stretch" Padding="0,13" Margin="0,24,0,0">
              <TextBlock x:Name="DeNovoText" Text="Já paguei, verificar de novo" FontSize="16" FontWeight="SemiBold"/>
            </Button>
            <Button Style="{StaticResource LinkBtn}" Content="Entrar com outra conta" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Click="OutraConta_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
