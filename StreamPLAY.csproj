<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StreamPLAY</AssemblyName>
    <RootNamespace>StreamPLAY</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.2.3</Version>
    <Product>StreamPLAY</Product>
    <Company>TheNIKITO</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <NoWarn>CA1416;NU1701</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);VlcPack\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- o motor do VLC vai junto, compactado dentro do VlcPack.dll -->
    <ProjectReference Include="VlcPack\VlcPack.csproj" />
    <AssemblyMetadata Include="VlcVersao" Value="$(VlcVersao)" />
  </ItemGroup>

</Project>
